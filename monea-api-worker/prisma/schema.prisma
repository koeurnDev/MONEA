generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String          @id @default(cuid())
  name                   String?
  phone                  String?
  email                  String          @unique
  emailVerified          Boolean         @default(false)
  password               String?
  googleId               String?         @unique
  telegramId             String?         @unique
  avatar                 String?
  role                   UserRole        @default(ADMIN)
  twoFactorSecret        String?
  twoFactorEnabled       Boolean         @default(false)
  twoFactorRecoveryCodes String?
  failedAttempts         Int             @default(0)
  lockedUntil            DateTime?
  sessionsRevokedAt      DateTime?
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  supportTickets         SupportTicket[]
  weddings               Wedding[]

  @@index([createdAt])
  @@index([deletedAt])                    // soft-delete filter
  @@index([role, createdAt(sort: Desc)]) // admin user list
}

model Wedding {
  id               String                   @id @default(cuid())
  groomName        String
  brideName        String
  location         String?
  date             DateTime
  eventType        EventType                @default(wedding)
  templateId       String                   @default("classic")
  themeSettings    Json?
  notes            String?
  weddingCode      String?                  @unique
  status           WeddingStatus            @default(ACTIVE)
  packageType      PackageType              @default(FREE)
  paymentStatus    PaymentStatus            @default(PENDING)
  expiresAt        DateTime?
  userId           String
  telegramLink     String?
  paymentInfo      String?
  paymentHash      String?
  bakongTrxId      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  activities       Activity[]
  galleryItems     GalleryItem[]
  gifts            Gift[]
  guests           Guest[]
  guestbookEntries GuestbookEntry[]
  analytics        InvitationAnalytics[]
  logs             Log[]
  staff            Staff[]
  supportTickets   SupportTicket[]
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateVersions WeddingTemplateVersion[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])                         // payment filter
  @@index([packageType])                           // package filter
  @@index([userId, status, createdAt(sort: Desc)]) // dashboard: my weddings
  @@index([status, paymentStatus])                 // admin: pending payments
}

model InvitationAnalytics {
  id         String        @id @default(cuid())
  weddingId  String
  type       AnalyticsType
  ipHash     String?
  userAgent  String?
  deviceType DeviceType?
  createdAt  DateTime      @default(now())
  wedding    Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([createdAt])
  @@index([weddingId, type, createdAt])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  time        String
  description String?
  icon        String?
  publicId    String?
  order       Int      @default(0)
  weddingId   String
  createdAt   DateTime @default(now())
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model Guest {
  id             String      @id @default(cuid())
  name           String
  phone          String?
  group          String?
  source         String?
  weddingId      String
  hasArrived     Boolean     @default(false)
  arrivedAt      DateTime?
  views          Int         @default(0)
  rsvpStatus     RsvpStatus? @default(PENDING)
  adultsCount    Int         @default(1)
  childrenCount  Int?        @default(0)
  rsvpNotes      String?
  rsvpAt         DateTime?
  guestCode      String?
  sequenceNumber Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  gifts          Gift[]
  wedding        Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([weddingId, guestCode])
  @@index([weddingId])
  @@index([hasArrived])
  @@index([weddingId, createdAt(sort: Desc)])
  @@index([weddingId, rsvpStatus])      // RSVP filter per wedding
  @@index([weddingId, hasArrived])      // check-in dashboard
  @@index([weddingId, group])           // group filter
}

model Gift {
  id             String         @id @default(cuid())
  amount         Decimal
  currency       Currency
  method         PaymentMethod?
  weddingId      String
  guestId        String?
  sequenceNumber Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  guest          Guest?         @relation(fields: [guestId], references: [id])
  wedding        Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([guestId])
  @@index([method])
  @@index([currency])
  @@index([weddingId, createdAt(sort: Desc)])
}

model GalleryItem {
  id        String    @id @default(cuid())
  url       String
  publicId  String?
  type      MediaType
  caption   String?
  weddingId String
  createdAt DateTime  @default(now())
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([weddingId, createdAt(sort: Desc)])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  guestName String
  message   String
  voiceUrl  String?
  weddingId String
  createdAt DateTime @default(now())
  wedding   Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([weddingId, createdAt(sort: Desc)])
}

model Staff {
  id                     String    @id @default(cuid())
  name                   String
  email                  String?   @unique
  password               String?
  pin                    String?
  role                   StaffRole @default(STAFF)
  weddingId              String
  accessToken            String?   @unique
  twoFactorSecret        String?
  twoFactorEnabled       Boolean   @default(false)
  twoFactorRecoveryCodes String?
  failedAttempts         Int       @default(0)
  lockedUntil            DateTime?
  sessionsRevokedAt      DateTime?
  createdAt              DateTime  @default(now())
  wedding                Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([weddingId, role])   // filter staff by role
}

model Log {
  id          String    @id @default(cuid())
  action      LogAction
  description String
  actorName   String
  ip          String?
  userAgent   String?
  weddingId   String
  createdAt   DateTime  @default(now())
  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([createdAt])
  @@index([weddingId, createdAt(sort: Desc)])
}

model BlacklistedIP {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model IpSecurity {
  id           String    @id @default(cuid())
  ip           String    @unique
  failures     Int       @default(0)
  blockedUntil DateTime?
  lastAttempt  DateTime  @updatedAt
}

model SecurityLog {
  id        String        @id @default(cuid())
  event     SecurityEvent
  ip        String
  geoIp     String?
  userAgent String?
  email     String?
  details   String?
  createdAt DateTime      @default(now())

  @@index([event])
  @@index([createdAt])
  @@index([ip])
  @@index([email])
}

model SystemConfig {
  id               String    @id @default("GLOBAL")
  maintenanceMode  Boolean   @default(false)
  maintenanceStart DateTime?
  maintenanceEnd   DateTime?
  allowNewSignups  Boolean   @default(true)
  globalCheckIn    Boolean   @default(true)
  stadPrice        Float     @default(9.0)
  proPrice         Float     @default(19.0)
  bakongConfig     Json?
  updatedAt        DateTime  @updatedAt
}

model Broadcast {
  id          String        @id @default(cuid())
  title       String
  message     String
  type        BroadcastType @default(INFO)
  active      Boolean       @default(true)
  scheduledAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([active, expiresAt]) // fetch active broadcasts efficiently
}

model SupportTicket {
  id        String         @id @default(cuid())
  subject   String
  message   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  weddingId String
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding   Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
  @@index([userId])
  @@index([status, priority])              // admin ticket triage
  @@index([createdAt(sort: Desc)])         // latest tickets first
}

model SystemVersion {
  id          String   @id @default(cuid())
  versionName String
  configData  Json
  description String?
  isStable    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
}

model GovernanceLog {
  id        String           @id @default(cuid())
  action    GovernanceAction
  details   Json
  actorId   String
  actorName String
  ip        String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([actorId])
  @@index([createdAt(sort: Desc)]) // governance audit log
  @@index([action])               // filter by action type
}

model WeddingTemplateVersion {
  id          String   @id @default(cuid())
  weddingId   String
  versionName String
  templateId  String
  themeData   Json
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model DailySecuritySummary {
  id             String   @id @default(cuid())
  date           DateTime @unique
  totalLogins    Int
  failedAttempts Int
  blockedIps     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF
}

enum WeddingStatus {
  ACTIVE
  ARCHIVED
}

enum PackageType {
  FREE
  PRO
  PREMIUM
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
}

enum EventType {
  wedding
  anniversary
}

enum AnalyticsType {
  VIEW
  MAP_CLICK
  SAVE_DATE
  RSVP_OPEN
  RSVP_SUBMIT
}

enum DeviceType {
  MOBILE
  DESKTOP
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum Currency {
  USD
  KHR
}

enum PaymentMethod {
  Cash
  ABA
  Wing
  ACLEDA
  KHQR
  Other
}

enum MediaType {
  IMAGE
  VIDEO
}

enum StaffRole {
  SCANNER
  CASHIER
  STAFF
}

enum LogAction {
  CHECK_IN
  GIFT
  UPDATE
  DELETE
  CREATE
  PAYMENT_APPROVAL
  LOGIN_FAILURE
}

enum SecurityEvent {
  LOGIN_FAILED
  LOGIN_SUCCESS
  RATE_LIMIT_EXCEEDED
  PASSWORD_CHANGE_SUCCESS
  PASSWORD_CHANGE_FAILED
  TWOFA_SETUP
  TWOFA_VERIFY
  TWOFA_DISABLED
  TWOFA_VERIFY_FAILED
  SESSION_REVOKED
}

enum BroadcastType {
  INFO
  WARNING
  SUCCESS
}

enum TicketStatus {
  OPEN
  CLOSED
  PENDING
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum GovernanceAction {
  PUBLISH
  ROLLBACK
  CONFIG_UPDATE
  ENABLE_2FA
  DISABLE_2FA
  REVOKE_SESSIONS
}

model SignupOTP {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
