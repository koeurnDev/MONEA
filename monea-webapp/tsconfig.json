{
    "compilerOptions":  {
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "react-jsx",
                            "types":  [
                                          "vite/client"
                                      ],
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ],
                                          "@/server/*":  [
                                                             "./monea-worker/*"
                                                         ]
                                      },
                            "target":  "ES2017"
                        },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",
                    "vite.config.ts"
                ],
    "exclude":  [
                    "node_modules"
                ]
}
