{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "target": "ES2017",
        "types": ["node"],
        "paths": {
            "@/lib/*":          ["./lib/*"],
            "@/services/*":     ["./lib/*"],
            "@/types/*":        ["./types/*"],
            "@/server/*":       ["./*"]
        }
    },
    "include": ["**/*.ts", "**/*.d.ts"],
    "exclude": ["node_modules"]
}
